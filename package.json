{
  "name": "version-code",
  "version": "1.0.0",
  "description": "版本号管理、比较",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "format": "prettier --write .",
    "lint": "eslint .",
    "ci:publish": "pnpm publish --no-git-checks --recursive --access public"
  },
  "keywords": [
    "version",
    "compare"
  ],
  "author": "Jander Fan",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "module": "dist/index.js",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ]
